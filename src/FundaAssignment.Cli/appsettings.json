{
  "Funda": {
    "Client": {
      // ApiKey is absent on purpose: set the environment variable Funda__Client__ApiKey.
      "BaseAddress": "http://partnerapi.funda.nl/feeds/Aanbod.svc/json/",
      "PageSize": 25,
      "RequestTimeout": "00:00:30"
    },
    "Resilience": {
      "RequestsPerMinute": 90,
      "MaxRetryAttempts": 3
    },
    "Caching": {
      "Enabled": true,
      "SnapshotWindow": "00:15:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    },
    "File": {
      "Path": "logs/funda-rank-.log"
    }
  }
}
